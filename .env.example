# Gemini API Key (Required for live Gemini tagline generation and LLM reviewer)
GEMINI_API_KEY=your_gemini_api_key_here

# Toggle mock LLM mode (true: offline mock mode; false: call Gemini API)
MOCK_LLM=true

# Image generation backend: 'mock' for fast gradient backgrounds; 'diffusers' for SD-Turbo + CLIP
IMAGE_BACKEND=mock

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

